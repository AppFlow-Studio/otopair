{
  "cli": {
    "version": ">= 18.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "config": "build-ios-npm.yml",
      "autoIncrement": true,
      "environment": "preview",
      "channel": "preview"
    },
    "production": {
      "config": "build-ios-npm.yml",
      "autoIncrement": true,
      "channel": "production"
    },
    "preview-android": {
      "config": "build-android-npm.yml",
      "autoIncrement": true,
      "environment": "preview",
      "channel": "preview"
    },
    "production-android": {
      "config": "build-android-npm.yml",
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
