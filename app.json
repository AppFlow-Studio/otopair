{
  "expo": {
    "name": "otopair",
    "slug": "otopair",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/repairconnectglasslogo.png",
    "scheme": "otopair",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.otopair.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.otopair.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "otopair",
              "host": "smartcar",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/repairconnectglasslogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Otopair to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow Otopair to use speech recognition to transcribe your voice."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Otopair to use your location to find nearby mechanics and provide accurate service availability.",
          "locationWhenInUsePermission": "Allow Otopair to use your location to find nearby mechanics and provide accurate service availability."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Otopair to use your camera to let you take photos of your vehicle and profile picture."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Otopair to access your photos to let you upload vehicle images and profile pictures."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/repairconnectglasslogo.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Otopair to add your service appointments to your calendar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
